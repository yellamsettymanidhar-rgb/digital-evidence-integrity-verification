# Copy this file to .env and fill in real values. Never commit .env itself.

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-hex-string

# SQLite path (default). To move to MySQL, see the "Switching to MySQL"
# section in README.md — DATABASE_PATH is only used by the SQLite path.
DATABASE_PATH=database/evidence.db

UPLOAD_FOLDER=uploads
REPORTS_FOLDER=reports

MAX_CONTENT_LENGTH_MB=100
